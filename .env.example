# The real .env is created and updated by: npm run set-password
# Never commit the real .env.

# Email used to log in at /edit
ADMIN_EMAIL=you@example.com
# scrypt hash of the admin password. Generate it with npm run set-password; never put the plain password here.
ADMIN_PASSWORD_HASH=
# Long random string used to sign login cookies. npm run set-password generates one.
SESSION_SECRET=
# true sends the login cookie only over HTTPS. Set false only if you test over plain http on a non-localhost address.
COOKIE_SECURE=true
# Port the Node server listens on (Apache proxies /api to it)
PORT=3001
